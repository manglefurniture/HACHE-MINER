[hache-miner]
; Dedicated low-footprint pool; install only after checking PHP-FPM capacity.
user = hache-miner
group = hache-miner
listen = /run/php/php8.4-fpm-hache-miner.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 1
pm.process_idle_timeout = 10s
pm.max_requests = 200
clear_env = yes
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[auto_prepend_file] = /etc/hache-miner/load-env.php
php_admin_value[session.save_path] = /var/lib/hache-miner/sessions
